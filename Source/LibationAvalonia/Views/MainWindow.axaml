<?xml version="1.0" encoding="UTF-8"?>
<Window xmlns="https://github.com/avaloniaui"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:LibationAvalonia.ViewModels"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:views="clr-namespace:LibationAvalonia.Views"
		xmlns:controls="clr-namespace:LibationAvalonia.Controls"
		mc:Ignorable="d" d:DesignWidth="1850" d:DesignHeight="700"
		x:Class="LibationAvalonia.Views.MainWindow"
		Title="Libation - Tipple"
		x:DataType="vm:MainVM"
		Name="Form1"
		Icon="/Assets/libation.ico">

	<Window.Resources>
		<!-- Simple shapes for ribbon actions Libation has no existing icon for. -->
		<StreamGeometry x:Key="RibbonExportIcon">M0,44 H12 V56 H48 V44 H60 V68 H0 Z M24,0 H36 V28 H52 L30,50 L8,28 H24 Z</StreamGeometry>
		<StreamGeometry x:Key="RibbonSettingsIcon">M0,0 H60 V12 H0 Z M0,28 H60 V40 H0 Z M0,56 H60 V68 H0 Z</StreamGeometry>
		<!-- Scan: the download arrow mirrored, pointing up into a bar. Deliberately the same
		     drawing as Download so the pair reads as "bring in" and "take out", and solid so it
		     matches the rest of the ribbon. Upstream ImportIcon is an outline glyph, which at any
		     size reads smaller than the solid icons beside it. -->
		<StreamGeometry x:Key="RibbonScanIcon">M0,0 H60 V10 H0 Z M24,68 H36 V40 H52 L30,18 L8,40 H24 Z</StreamGeometry>
		<!-- PDFs: a page outline with a folded corner, same 60x68 box as the others. The second
		     subpath is wound the opposite way to the first, which punches the hole rather than
		     drawing a second shape. Filled solid it was 96% ink against 26% for the arrows, and
		     read as a black slab twice the size of its neighbours; hollow it is 44%, in line with
		     the hourglass and the settings bars. Replaces the
		     upstream PdfDownloadedIcon in the ribbon only; that one still serves the grid. -->
		<StreamGeometry x:Key="RibbonPdfIcon">M0,0 H42 L60,18 V68 H0 Z M6,8 V60 H54 V26 H34 V8 Z</StreamGeometry>
		<StreamGeometry x:Key="RibbonDownloadIcon">M24,0 H36 V28 H52 L30,50 L8,28 H24 Z M0,58 H60 V68 H0 Z</StreamGeometry>
		<!-- Text wrapping: a full line, a line that stops short, and a return arrow turning
		     down off the end of it and back to the left margin. Drawn as four solid subpaths
		     with no overlaps, so it fills predictably at any size. -->
		<StreamGeometry x:Key="WrapTextIcon">M0,0 H64 V8 H0 Z M0,16 H50 V24 H0 Z M56,16 H64 V40 H56 Z M26,32 H64 V40 H26 V48 L8,36 L26,24 Z</StreamGeometry>
		<!-- At risk: an hourglass. Plus titles run out of time whether or not you download
		     them, and this is the only ribbon action about something expiring. -->
		<StreamGeometry x:Key="RibbonAtRiskIcon">M4,0 H60 V10 L38,32 L60,54 V64 H4 V54 L26,32 L4,10 Z</StreamGeometry>
		<!-- No wrapping: lines running straight off the right edge, i.e. one long line
		     clipped by the column rather than folded onto the next. Shown when wrapping is
		     already on, because the button advertises what pressing it will do. -->
		<StreamGeometry x:Key="NoWrapTextIcon">M0,0 H64 V8 H0 Z M0,20 H44 V28 H0 Z M44,14 L64,24 L44,34 Z M0,40 H40 V48 H0 Z</StreamGeometry>
	</Window.Resources>

	<Window.KeyBindings>
		<!-- Both together -->
		<KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding IncreaseGridFontSize}" />
		<KeyBinding Gesture="Ctrl+Add" Command="{Binding IncreaseGridFontSize}" />
		<KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding DecreaseGridFontSize}" />
		<KeyBinding Gesture="Ctrl+Subtract" Command="{Binding DecreaseGridFontSize}" />
		<KeyBinding Gesture="Ctrl+D0" Command="{Binding ResetGridFontSize}" />

		<!-- Row height only -->
		<KeyBinding Gesture="Ctrl+Alt+OemPlus" Command="{Binding IncreaseRowHeight}" />
		<KeyBinding Gesture="Ctrl+Alt+OemMinus" Command="{Binding DecreaseRowHeight}" />

		<!-- Text size only -->
		<KeyBinding Gesture="Ctrl+Shift+OemPlus" Command="{Binding IncreaseTextOnly}" />
		<KeyBinding Gesture="Ctrl+Shift+OemMinus" Command="{Binding DecreaseTextOnly}" />
	</Window.KeyBindings>

	<NativeMenu.Menu>
		<NativeMenu>
			<NativeMenuItem Header="Import">
				<NativeMenu>
					<NativeMenuItem
						Header="Auto Scan Library"
						Command="{Binding ToggleAutoScan}"
						IsChecked="{Binding AutoScanChecked}"
						ToggleType="CheckBox" />
					<NativeMenuItemSeparator />
				</NativeMenu>
			</NativeMenuItem>
			<NativeMenuItem Header="Download">
				<NativeMenu>
					<NativeMenuItem Command="{Binding BackupAllBooks}" Header="{Binding BookBackupsToolStripText}" Gesture="{OnPlatform macOS='alt+⌘+B'}" />
					<NativeMenuItem Command="{Binding BackupAllPdfs}" Header="{Binding PdfBackupsToolStripText}"  Gesture="{OnPlatform macOS='alt+⌘+P'}"/>
					<NativeMenuItem Command="{Binding ConvertAllToMp3Async}" Header="Convert all M4b to Mp3 [Long-running]..." />
					<NativeMenuItem Command="{Binding LiberateVisible}" Header="{Binding LiberateVisibleToolStripText}" IsEnabled="{Binding AnyVisibleNotLiberated}" />
				</NativeMenu>
			</NativeMenuItem>
			<NativeMenuItem Header="Export">
				<NativeMenu>
					<NativeMenuItem Command="{Binding ExportLibraryAsync}" Header="Export Library" Gesture="{OnPlatform macOS='alt+⌘+X'}"/>
				</NativeMenu>
			</NativeMenuItem>
			<NativeMenuItem Header="Quick Filters">
				<NativeMenu>
					<NativeMenuItem
						Header="Start Libation with 1st filter Default"
						Command="{Binding ToggleFirstFilterIsDefault}"
						IsChecked="{Binding FirstFilterIsDefault}"
						ToggleType="CheckBox" />
					<NativeMenuItem Command="{Binding EditQuickFiltersAsync}" Header="Edit quick filters..." Gesture="{OnPlatform macOS='alt+⌘+Q'}" />
					<NativeMenuItemSeparator />
				</NativeMenu>
			</NativeMenuItem>
			<NativeMenuItem Header="Visible Books">
				<NativeMenu>
					<NativeMenuItem Command="{Binding LiberateVisible}" Header="{Binding LiberateVisibleToolStripText_2}" IsEnabled="{Binding AnyVisibleNotLiberated}" Gesture="{OnPlatform macOS='alt+⌘+V'}" />
					<NativeMenuItem Command="{Binding ReplaceTagsAsync}" Header="Replace Tags..." />
					<NativeMenuItem Command="{Binding SetBookDownloadedAsync}" Header="Set book 'Downloaded' status manually..." />
					<NativeMenuItem Command="{Binding SetPdfDownloadedAsync}" Header="Set PDF 'Downloaded' status manually..." />
					<NativeMenuItem Command="{Binding SetDownloadedAutoAsync}" Header="Set 'Downloaded' status automatically..." />
					<NativeMenuItem Command="{Binding RemoveVisibleAsync}" Header="Remove from library..." />
				</NativeMenu>
			</NativeMenuItem>
			<NativeMenuItem Header="Settings">
				<NativeMenu>
					<NativeMenuItem Command="{Binding ShowAccountsAsync}" Header="Accounts..." Gesture="{OnPlatform macOS='⌘+.'}" />
					<NativeMenuItem Command="{Binding ShowSettingsAsync}" Header="Settings..." Gesture="{OnPlatform macOS='⌘+,'}" />
					<NativeMenuItemSeparator />
					<NativeMenuItem Command="{Binding ShowTrashBinAsync}" Header="Trash Bin" Gesture="{OnPlatform macOS='alt+⌘+T'}" />
					<NativeMenuItem Command="{Binding LaunchHangover}" Header="Launch Hangover" />
					<NativeMenuItemSeparator />
					<NativeMenuItem Command="{Binding StartWalkthroughAsync}" Header="Take a Guided Tour of Libation" />
					<NativeMenuItem Command="{Binding ShowDiagnosticsAsync}" Header="Diagnostics..." />
					<NativeMenuItem Command="{Binding ShowAboutAsync}" Header="About..." />
				</NativeMenu>
			</NativeMenuItem>
		</NativeMenu>
	</NativeMenu.Menu>

	<!-- MainWindow isn't a DialogWindow, so it doesn't pick up the outline from the
	     DialogWindow template and needs its own. -->
	<Border BorderThickness="2" BorderBrush="{DynamicResource WindowOutline}">
	<Grid RowDefinitions="Auto,Auto,*,Auto">
		<Border Grid.Row="0"  BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,1">
			<Grid ColumnDefinitions="*,Auto">
			<!-- Menu Strip -->
			<Menu VerticalAlignment="Top" IsVisible="{Binding MenuBarVisible}">
					
				<!-- Decrease height of menu strop -->					
				<Menu.Styles>
					<Style Selector="Menu /template/ ItemsPresenter#PART_ItemsPresenter">
						<Setter Property="Height" Value="25"/>
					</Style>
				</Menu.Styles>

				<!-- Import Menu -->
					
				<MenuItem Name="importToolStripMenuItem" Header="_Library">
					<MenuItem IsVisible="{Binding AnyAccounts}" Command="{Binding ToggleAutoScan}" Header="A_uto Scan Library">
						<MenuItem.Icon>
							<CheckBox BorderThickness="0" IsChecked="{Binding AutoScanChecked, Mode=TwoWay}" IsHitTestVisible="False" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem IsVisible="{Binding !AnyAccounts}" Command="{Binding AddAccountsAsync}" Header="No accounts yet. A_dd Account..." />
						
					<!-- Scan Library -->
					<MenuItem IsVisible="{Binding OneAccount}" IsEnabled="{Binding !ActivelyScanning}" Name="scanLibraryToolStripMenuItem" Command="{Binding ScanAccountAsync}" Header="Scan _Library" />
					<MenuItem IsVisible="{Binding MultipleAccounts}" IsEnabled="{Binding !ActivelyScanning}" Name="scanLibraryOfAllAccountsToolStripMenuItem" Command="{Binding ScanAllAccountsAsync}" Header="Scan Library of _All Accounts" />
					<MenuItem IsVisible="{Binding MultipleAccounts}" IsEnabled="{Binding !ActivelyScanning}" Command="{Binding ScanSomeAccountsAsync}" Header="Scan Library of _Some Accounts" />
						
					<Separator IsVisible="{Binding AnyAccounts}" />
						
					<!-- Remove Books -->
					<MenuItem IsVisible="{Binding OneAccount}" IsEnabled="{Binding RemoveMenuItemsEnabled}" Command="{Binding RemoveBooksAsync}" Header="_Remove Library Books" />
					<MenuItem IsVisible="{Binding MultipleAccounts}" IsEnabled="{Binding RemoveMenuItemsEnabled}" Command="{Binding RemoveBooksAllAsync}" Header="_Remove Books from All Accounts" />
					<MenuItem IsVisible="{Binding MultipleAccounts}" IsEnabled="{Binding RemoveMenuItemsEnabled}" Command="{Binding RemoveBooksSomeAsync}" Header="_Remove Books from Some Accounts" />
						
					<Separator />
					<MenuItem Command="{Binding LocateAudiobooksAsync}" Header="L_ocate Audiobooks..." ToolTip.Tip="{Binding LocateAudiobooksTip}" />
					<Separator />
					<MenuItem Command="{Binding ImportLocalFolderAsync}" Header="Add Audiobooks from _Folder..." ToolTip.Tip="Add DRM-free audiobooks you already have on disk. Files are never moved or renamed." />
					<MenuItem Command="{Binding AddCatalogueEntriesAsync}" Header="Add Books You _Own Elsewhere..." ToolTip.Tip="Record books you own but have no file for, so your library is complete." />

					<Separator />
					<MenuItem IsEnabled="{Binding LibraryStats?.HasBookResults, TargetNullValue=false}" Command="{Binding ExportLibraryAsync}" Header="E_xport Library..." InputGesture="ctrl+S" />

				</MenuItem>

				<!-- Download Menu -->

				<MenuItem Header="_Download">
					<MenuItem Command="{Binding BackupAllBooks}" Header="{Binding BookBackupsToolStripText}" />
					<MenuItem Command="{Binding BackupAllPdfs}" Header="{Binding PdfBackupsToolStripText}" />
					<MenuItem Command="{Binding ConvertAllToMp3Async}" Header="Convert all _M4b to Mp3 [Long-running]..." />
					<Separator />
					<MenuItem Command="{Binding LiberateVisible}" Header="{Binding LiberateVisibleToolStripText}" IsEnabled="{Binding AnyVisibleNotLiberated}" />
				</MenuItem>

				<!-- View Menu -->

				<MenuItem Header="_View">
					<MenuItem Header="_Theme">
						<MenuItem Command="{Binding SetThemeSystem}" Header="Match _system" ToggleType="Radio" IsChecked="{Binding ThemeIsSystem, Mode=OneWay}" />
						<MenuItem Command="{Binding SetThemeLight}" Header="_Light" ToggleType="Radio" IsChecked="{Binding ThemeIsLight, Mode=OneWay}" />
						<MenuItem Command="{Binding SetThemeDark}" Header="_Dark" ToggleType="Radio" IsChecked="{Binding ThemeIsDark, Mode=OneWay}" />
						<Separator />
						<MenuItem Header="Saved _color schemes" ItemsSource="{Binding SavedThemeMenuItems}" />
						<MenuItem Command="{Binding ShowThemeEditor}" Header="_Edit colors..." />
					</MenuItem>
					<MenuItem Command="{Binding ToggleGridTextWrapping}" Header="_Wrap text in narrow columns" ToggleType="CheckBox" IsChecked="{Binding GridTextWrapping, Mode=OneWay}" />
					<MenuItem Command="{Binding ToggleShowRibbon}" Header="Show _Ribbon" ToggleType="CheckBox" IsChecked="{Binding ShowRibbon, Mode=OneWay}" />
					<MenuItem Command="{Binding ToggleStripNonPersonAuthors}" Header="Hide _imprints from last-name columns" ToggleType="CheckBox" IsChecked="{Binding StripNonPersonAuthors, Mode=OneWay}" ToolTip.Tip="Hides non-people such as 'The Great Courses' from the last-name author and narrator columns" />
					<Separator />
					<MenuItem Name="quickFiltersToolStripMenuItem" Header="Quick _Filters" ItemsSource="{Binding QuickFilterMenuItems}" />
					<Separator />
					<MenuItem Header="{Binding VisibleCountMenuItemText}" >
						<MenuItem Command="{Binding LiberateVisible}" Header="{Binding LiberateVisibleToolStripText_2}" IsEnabled="{Binding AnyVisibleNotLiberated}" />
						<MenuItem Command="{Binding ReplaceTagsAsync}" Header="Replace _Tags..." />
						<MenuItem Command="{Binding SetBookDownloadedAsync}" Header="Set book '_Downloaded' status manually..." />
						<MenuItem Command="{Binding SetPdfDownloadedAsync}" Header="Set _PDF 'Downloaded' status manually..." />
						<MenuItem Command="{Binding SetDownloadedAutoAsync}" Header="Set '_Downloaded' status automatically..." />
						<MenuItem Command="{Binding RemoveVisibleAsync}" Header="_Remove from library..." />
					</MenuItem>
				</MenuItem>

				<!-- Settings Menu -->

				<MenuItem Header="_Settings" Name="settingsToolStripMenuItem">
					<MenuItem Name="accountsToolStripMenuItem" Command="{Binding ShowAccountsAsync}" Header="_Accounts..." InputGesture="ctrl+shift+A"/>
					<MenuItem Name="basicSettingsToolStripMenuItem" Command="{Binding ShowSettingsAsync}" Header="_Settings..." InputGesture="ctrl+P" />
					<Separator />
					<MenuItem Command="{Binding ShowTrashBinAsync}" Header="Trash Bin" />
					<MenuItem Command="{Binding LaunchHangover}" Header="Launch _Hangover" />
					<Separator />
					<MenuItem Command="{Binding ShowFindBetterQualityBooksAsync}" Header="Scan for Better Quality Audiobooks"  ToolTip.Tip="{Binding FindBetterQualityBooksTip}"/>
					<Separator />
					<MenuItem Command="{Binding StartWalkthroughAsync}" Header="Take a Guided _Tour of Libation" />
					<MenuItem Command="{Binding ShowDiagnosticsAsync}" Header="_Diagnostics..." ToolTip.Tip="Where Libation's files, database and log actually are, and whether they are working." />
					<MenuItem Command="{Binding ShowAboutAsync}" Header="A_bout..." />
				</MenuItem>
			</Menu>
				
			<StackPanel IsVisible="{Binding ActivelyScanning}" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
				<Path VerticalAlignment="Center" Fill="{DynamicResource IconFill}" Data="{StaticResource ImportIcon}" />
				<TextBlock Margin="5,0,5,0" VerticalAlignment="Center" Text="{Binding ScanningText}"/>
			</StackPanel>
		</Grid>
		</Border>
		<!-- Buttons and Search Box -->
		<!-- Ribbon and filter share one row. The ribbon takes its natural width on the left,
		     the filter box stretches into whatever is left, and the grid size steppers sit on
		     the right. Show Ribbon hides only the button sections, not the filter. -->
		<Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource GridLines}">
			<Grid Margin="8,4" MinHeight="48" ColumnDefinitions="Auto,*,Auto">

				<Grid.Styles>
					<!-- Scoped to the filter area so the ribbon's own button style does not
					     inflate them, and theirs does not shrink the ribbon. -->
						<Style Selector="Grid#filterArea TextBox">
							<Setter Property="MinHeight" Value="10" />
						</Style>
						<Style Selector="Grid#filterArea Button">
							<Setter Property="Padding" Value="12,2" />
							<Setter Property="Margin" Value="10,0,0,0" />
							<Setter Property="HorizontalContentAlignment" Value="Center" />
							<Setter Property="VerticalContentAlignment" Value="Center" />
						</Style>
				</Grid.Styles>

				<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowRibbon}">
					<StackPanel.Styles>
						<Style Selector="Button">
							<Setter Property="Padding" Value="10,4" />
							<Setter Property="MinWidth" Value="64" />
						</Style>
						<!-- Icon over label, so actions stay legible without inventing
						     meanings for shapes Libation has no established icon for. -->
						<Style Selector="Button > StackPanel">
							<Setter Property="Orientation" Value="Vertical" />
							<Setter Property="HorizontalAlignment" Value="Center" />
							<Setter Property="Spacing" Value="3" />
						</Style>
						<!-- Height only, no Width. With Uniform stretch inside a fixed 18x18 box, a
						     geometry wider than it is tall fits to the width and comes out short:
						     the Settings bars rendered 15px against everyone else's 18px. Constraining
						     only the height makes every icon the same height and lets the width follow
						     the artwork. -->
						<Style Selector="Button Path">
							<Setter Property="Height" Value="18" />
							<Setter Property="Stretch" Value="Uniform" />
							<Setter Property="HorizontalAlignment" Value="Center" />
							<Setter Property="Fill" Value="{DynamicResource IconFill}" />
						</Style>
						<Style Selector="Button TextBlock">
							<Setter Property="FontSize" Value="11" />
							<Setter Property="HorizontalAlignment" Value="Center" />
							<!-- Two lines' worth whether the label uses them or not. Scan and Settings are
							     one line while Download ALL is two, which made those buttons shorter and
							     their icons sit in a smaller box. The icons were always identical; the
							     buttons around them were not. -->
							<Setter Property="MinHeight" Value="30" />
							<!-- The download buttons use two-line labels to stay narrow; centre
							     both lines rather than left-aligning the second. -->
							<Setter Property="TextAlignment" Value="Center" />
						</Style>
						<!-- Section caption. Quiet on purpose: it names the group without
						     competing with the buttons above it. -->
						<Style Selector="TextBlock.ribbonSection">
							<Setter Property="FontSize" Value="10" />
							<Setter Property="Opacity" Value="0.6" />
							<Setter Property="HorizontalAlignment" Value="Center" />
							<Setter Property="Margin" Value="0,3,0,0" />
						</Style>
						<Style Selector="StackPanel.ribbonSection">
							<Setter Property="Orientation" Value="Vertical" />
						</Style>
						<Style Selector="StackPanel.ribbonSectionButtons">
							<Setter Property="Orientation" Value="Horizontal" />
							<Setter Property="Spacing" Value="4" />
						</Style>
						<Style Selector="Border.ribbonDivider">
							<Setter Property="Width" Value="1" />
							<Setter Property="Margin" Value="4,2" />
							<Setter Property="Background" Value="{DynamicResource GridLines}" />
						</Style>
					</StackPanel.Styles>

					<!-- Library -->
					<StackPanel Classes="ribbonSection">
						<StackPanel Classes="ribbonSectionButtons">
							<Button
								IsVisible="{Binding OneAccount}"
								IsEnabled="{Binding !ActivelyScanning}"
								Command="{Binding ScanAccountAsync}"
								ToolTip.Tip="Scan your Audible library for new books">
								<StackPanel>
									<Path Data="{StaticResource RibbonScanIcon}" />
									<TextBlock Text="Scan" />
								</StackPanel>
							</Button>
							<Button
								IsVisible="{Binding MultipleAccounts}"
								IsEnabled="{Binding !ActivelyScanning}"
								Command="{Binding ScanAllAccountsAsync}"
								ToolTip.Tip="Scan all accounts for new books">
								<StackPanel>
									<Path Data="{StaticResource RibbonScanIcon}" />
									<TextBlock Text="Scan all" />
								</StackPanel>
							</Button>
						</StackPanel>
						<TextBlock Classes="ribbonSection" Text="Library" />
					</StackPanel>
					<Border Classes="ribbonDivider" />

					<!-- Download -->
					<StackPanel Classes="ribbonSection">
						<StackPanel Classes="ribbonSectionButtons">
							<Button
								Command="{Binding BackupAllBooks}"
								ToolTip.Tip="{Binding BookBackupsToolStripText}">
								<StackPanel>
									<Path Data="{StaticResource RibbonDownloadIcon}" />
									<TextBlock Text="Download&#x0A;ALL" />
								</StackPanel>
							</Button>
							<Button
								Command="{Binding LiberateVisible}"
								IsEnabled="{Binding AnyVisibleNotLiberated}"
								ToolTip.Tip="{Binding LiberateVisibleToolStripText}">
								<StackPanel>
									<Path Data="{StaticResource RibbonDownloadIcon}" />
									<TextBlock Text="Download&#x0A;Books" />
								</StackPanel>
							</Button>
							<Button
								Command="{Binding BackupAllPdfs}"
								ToolTip.Tip="{Binding PdfBackupsToolStripText}">
								<StackPanel>
									<Path Data="{StaticResource RibbonPdfIcon}" />
									<TextBlock Text="Download&#x0A;PDFs" />
								</StackPanel>
							</Button>
						</StackPanel>
						<TextBlock Classes="ribbonSection" Text="Download" />
					</StackPanel>
					<Border Classes="ribbonDivider" />

					<!-- Filter. At Risk leads, then the saved quick filters, which are last in the
					     whole ribbon so a narrow window clips these rather than Scan or Download. -->
					<StackPanel Classes="ribbonSection">
						<StackPanel Classes="ribbonSectionButtons">
							<Button
								Command="{Binding FilterAtRisk}"
								ToolTip.Tip="{Binding AtRiskTip}">
								<StackPanel>
									<Path Data="{StaticResource RibbonAtRiskIcon}" />
									<TextBlock Text="At&#x0A;Risk" />
								</StackPanel>
							</Button>
							<ItemsControl ItemsSource="{Binding RibbonQuickFilters}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Orientation="Horizontal" Spacing="4" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate DataType="vm:QuickFilterButton">
										<Button
											Command="{Binding Apply}"
											ToolTip.Tip="{Binding Tip}"
											VerticalAlignment="Stretch"
											VerticalContentAlignment="Center">
											<TextBlock Text="{Binding Label}" />
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
						<TextBlock Classes="ribbonSection" Text="Filter" />
					</StackPanel>
					<Border Classes="ribbonDivider" />

					<!-- Tools -->
					<StackPanel Classes="ribbonSection">
						<StackPanel Classes="ribbonSectionButtons">
							<Button
								IsEnabled="{Binding LibraryStats?.HasBookResults, TargetNullValue=false}"
								Command="{Binding ExportLibraryAsync}"
								ToolTip.Tip="Export your library to a file">
								<StackPanel>
									<Path Data="{StaticResource RibbonExportIcon}" />
									<TextBlock Text="Export" />
								</StackPanel>
							</Button>
							<Button
								Command="{Binding ShowSettingsAsync}"
								ToolTip.Tip="Open settings">
								<StackPanel>
									<Path Data="{StaticResource RibbonSettingsIcon}" />
									<TextBlock Text="Settings" />
								</StackPanel>
							</Button>
						</StackPanel>
						<TextBlock Classes="ribbonSection" Text="Tools" />
					</StackPanel>
					<!-- Closes the ribbon off from the filter area. Wider margin than the dividers
					     between sections, so the boundary between the two halves of the row reads
					     as more than just another section break. -->
					<Border Classes="ribbonDivider" Margin="12,2,4,2" />
				</StackPanel>

				<Grid Grid.Column="1" Name="filterArea" Margin="6,0,0,0" ColumnDefinitions="Auto,*">

				<!-- Search syntax help. Lists every searchable field, which now includes
				     includeduntil/Expires, so it is the only place that documents them. -->
				<StackPanel Grid.Column="0" IsVisible="{Binding !RemoveButtonsVisible}" Orientation="Horizontal">
					<Button Name="filterHelpBtn" Margin="0" Command="{Binding FilterHelpBtn}" Content="?" ToolTip.Tip="Filter options: the fields you can search and how to combine them" />
				</StackPanel>

				<StackPanel Grid.Column="1" Orientation="Horizontal">
					<Button IsVisible="{Binding RemoveButtonsVisible}" IsEnabled="{Binding RemoveBooksButtonEnabled}" Command="{Binding RemoveBooksBtn}" Content="{Binding RemoveBooksButtonText}"/>
					<Button IsVisible="{Binding RemoveButtonsVisible}" Command="{Binding DoneRemovingBtn}" Content="Done Removing Books"/>
				</StackPanel>

				<!-- Stretches instead of the old fixed 620 cap. Column 1 is the star column and
				     the filter string is the longest thing anyone types here: the At Risk query
				     alone ran off the end of the old box. -->
				<Grid
					Grid.Column="1"
					Margin="10,0,10,0"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Center"
					ColumnDefinitions="Auto,*,Auto,Auto,Auto"
					IsVisible="{Binding !RemoveButtonsVisible}">
					<TextBlock
						Grid.Column="0"
						Margin="0,0,8,0"
						VerticalAlignment="Center"
						Text="Filter" />
					<TextBox
						Grid.Column="1"
						Name="filterSearchTb"
						Height="28"
						VerticalContentAlignment="Center"
						InnerRightContent="{x:Null}"
						ScrollViewer.HorizontalScrollBarVisibility="Auto"
						ScrollViewer.VerticalScrollBarVisibility="Disabled"
						Text="{Binding SelectedNamedFilter.Filter, Mode=OneWay}"
						KeyDown="filterSearchTb_KeyPress" />
					<!-- Applies what is in the box. Same height as CLEAR beside it; it used to sit
					     in the right-hand group, away from the box it acts on. -->
					<Button
						Grid.Column="2"
						Name="filterBtn"
						Margin="6,0,0,0"
						Padding="10,2"
						Height="28"
						VerticalContentAlignment="Center"
						HorizontalContentAlignment="Center"
						Command="{Binding FilterBtn}"
						CommandParameter="{Binding #filterSearchTb.Text}"
						Content="Filter"
						ToolTip.Tip="Apply the filter in the box" />
					<Button
						Grid.Column="3"
						Margin="6,0,0,0"
						Padding="10,2"
						Height="28"
						VerticalContentAlignment="Center"
						Click="ClearFilterButton_Click"
						Content="CLEAR"
						ToolTip.Tip="Clear filter" />
					<!-- Next to CLEAR because both act on whatever is currently in the box. -->
					<Button
						Grid.Column="4"
						Name="addQuickFilterBtn"
						Margin="6,0,0,0"
						Padding="10,2"
						Height="28"
						VerticalContentAlignment="Center"
						Command="{Binding AddQuickFilterBtn}"
						Content="Add To Quick Filters"
						ToolTip.Tip="Save what is in the box as a quick filter, and put it on the ribbon" />
				</Grid>




				</Grid>

				<StackPanel Grid.Column="2" Orientation="Horizontal">
					<!-- Text size on top, row height below. Bound to the single-factor commands,
					     NOT to IncreaseGridFontSize/DecreaseGridFontSize, which step both factors
					     and made the A and R rows behave identically. A and R are fully decoupled:
					     A never moves the rows, R has its whole range regardless of font size.
					     Ctrl+Plus/Minus and Ctrl+wheel keep the zoom-everything behaviour. -->
					<StackPanel Orientation="Vertical" Margin="10,0,0,0">
						<StackPanel.Styles>
							<!-- One width for all nine stepper buttons. They used to size to their content, and
							     S is a narrower glyph than A or R in a proportional font, so each S button came
							     out slightly small and the error accumulated: S+ sat left of A+ and R+. -->
							<Style Selector="Button">
								<Setter Property="Width" Value="38" />
								<Setter Property="Padding" Value="0" />
								<Setter Property="HorizontalContentAlignment" Value="Center" />
							</Style>
						</StackPanel.Styles>
						<StackPanel Orientation="Horizontal">
							<!-- Fixed width and right-aligned so the A and R buttons below stay
							     in line as the numbers change width. -->
							<TextBlock
								Width="68"
								Margin="0,0,6,0"
								FontSize="11"
								TextAlignment="Right"
								VerticalAlignment="Center"
								Text="{Binding GridFontSizeText}"
								ToolTip.Tip="Current grid text size"
								AutomationProperties.Name="Current grid text size" />
							<Button
								Padding="10,2"
								Command="{Binding DecreaseTextOnly}"
								ToolTip.Tip="Smaller grid text (row height unchanged)"
								AutomationProperties.Name="Decrease grid text size"
								Content="A&#x2013;" />
							<Button
								Margin="4,0,0,0"
								Padding="10,2"
								Command="{Binding ResetTextOnly}"
								ToolTip.Tip="Reset grid text to default size"
								AutomationProperties.Name="Reset grid text size to default"
								Content="A0" />
							<Button
								Margin="4,0,0,0"
								Padding="10,2"
								Command="{Binding IncreaseTextOnly}"
								ToolTip.Tip="Larger grid text (row height unchanged)"
								AutomationProperties.Name="Increase grid text size"
								Content="A+" />
						</StackPanel>
						<StackPanel Orientation="Horizontal" Margin="0,3,0,0">
							<TextBlock
								Width="68"
								Margin="0,0,6,0"
								FontSize="11"
								TextAlignment="Right"
								VerticalAlignment="Center"
								Text="{Binding GridRowHeightText}"
								ToolTip.Tip="Current grid row height"
								AutomationProperties.Name="Current grid row height" />
							<Button
								Padding="10,2"
								Command="{Binding DecreaseRowHeight}"
								ToolTip.Tip="Shorter rows (text size unchanged)"
								AutomationProperties.Name="Decrease row height"
								Content="R&#x2013;" />
							<Button
								Margin="4,0,0,0"
								Padding="10,2"
								Command="{Binding ResetRowHeight}"
								ToolTip.Tip="Reset rows to default height"
								AutomationProperties.Name="Reset row height to default"
								Content="R0" />
							<Button
								Margin="4,0,0,0"
								Padding="10,2"
								Command="{Binding IncreaseRowHeight}"
								ToolTip.Tip="Taller rows (text size unchanged)"
								AutomationProperties.Name="Increase row height"
								Content="R+" />
						</StackPanel>
						<!-- Shading strength for alternating rows. Third row so it lines up with the
						     A and R steppers; the readout is the stored ARGB, alpha first. Writes
						     through ChardonnayTheme, so it persists per theme and stays editable in
						     the theme editor rather than becoming a competing setting. -->
						<StackPanel Orientation="Horizontal" Margin="0,3,0,0">
							<TextBlock
								Width="68"
								Margin="0,0,6,0"
								FontSize="11"
								TextAlignment="Right"
								VerticalAlignment="Center"
								Text="{Binding RowShadeText}"
								ToolTip.Tip="{Binding RowShadeTip}"
								AutomationProperties.Name="Current alternating row shading" />
							<Button
								Padding="10,2"
								Command="{Binding LightenAlternatingRows}"
								ToolTip.Tip="{Binding RowShadeTip}"
								AutomationProperties.Name="Lighten alternating row shading"
								Content="S&#x2013;" />
							<Button
								Margin="4,0,0,0"
								Padding="10,2"
								Command="{Binding ResetAlternatingRows}"
								ToolTip.Tip="Reset the row shading to the theme default"
								AutomationProperties.Name="Reset alternating row shading to default"
								Content="S0" />
							<Button
								Margin="4,0,0,0"
								Padding="10,2"
								Command="{Binding DarkenAlternatingRows}"
								ToolTip.Tip="{Binding RowShadeTip}"
								AutomationProperties.Name="Darken alternating row shading"
								Content="S+" />
						</StackPanel>
					</StackPanel>

					<!-- Same command as View > Wrap text in narrow columns; this is just a
					     reachable home for it next to the controls it interacts with.
					     A plain Button rather than a ToggleButton: the icon advertises the
					     result of pressing, so a pressed/unpressed state would be a second
					     state signal pointing the opposite way. Current state is still legible
					     from the icon, since the wrap arrow only shows while text is unwrapped. -->
					<Button
						Margin="6,0,0,0"
						Padding="10,2"
						VerticalAlignment="Stretch"
						VerticalContentAlignment="Center"
						Command="{Binding ToggleGridTextWrapping}"
						ToolTip.Tip="{Binding GridTextWrappingTip}"
						AutomationProperties.Name="Toggle text wrapping in grid columns">
						<!-- The filter toolbar has no Path styling of its own, unlike the ribbon,
						     so size and fill are set here. AutomationProperties.Name above carries
						     the meaning now that there is no letter to read. -->
						<Panel>
							<Path
								IsVisible="{Binding !GridTextWrapping}"
								Width="18"
								Height="14"
								Stretch="Uniform"
								Fill="{DynamicResource IconFill}"
								Data="{StaticResource WrapTextIcon}" />
							<Path
								IsVisible="{Binding GridTextWrapping}"
								Width="18"
								Height="14"
								Stretch="Uniform"
								Fill="{DynamicResource IconFill}"
								Data="{StaticResource NoWrapTextIcon}" />
						</Panel>
					</Button>


					<Button Margin="10,0,0,0" Padding="4,2" Height="40" VerticalAlignment="Center" Command="{Binding ToggleQueueHideBtn}">
						<Path Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource IconFill}" Data="{StaticResource	LeftArrows}">
							<Path.RenderTransform>
								<RotateTransform Angle="{Binding QueueButtonAngle}"/>
							</Path.RenderTransform>
						</Path>
					</Button>
				</StackPanel>
			</Grid>
		</Border>
		
		<Border Grid.Row="2" Margin="8,0" BorderThickness="1" BorderBrush="{DynamicResource SystemBaseMediumLowColor}">
			<!-- A Grid rather than a SplitView: SplitView has a fixed OpenPaneLength and no
			     resize grip, so the queue pane could not be resized at all. The splitter and
			     pane column collapse together when the queue is hidden. Column width is saved
			     and restored in MainWindow.axaml.cs. -->
			<Grid Name="queueSplitGrid">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" MinWidth="200" />
					<ColumnDefinition Width="Auto" />
					<!-- Sized from code-behind; see Configure_QueuePaneWidth. -->
					<ColumnDefinition Width="Auto" MinWidth="0" />
				</Grid.ColumnDefinitions>

				<!-- Product Display Grid -->
				<views:ProductsDisplay
					Grid.Column="0"
					Name="productsDisplay"
					DataContext="{Binding ProductsDisplay, Mode=OneTime}"
					LiberateClicked="ProductsDisplay_LiberateClicked"
					TagsButtonClicked="ProductsDisplay_TagsButtonClicked"
					LiberateSeriesClicked="ProductsDisplay_LiberateSeriesClicked"
					ConvertToMp3Clicked="ProductsDisplay_ConvertToMp3Clicked" />

				<GridSplitter
					Grid.Column="1"
					Name="queueSplitter"
					Width="5"
					ResizeDirection="Columns"
					ResizeBehavior="PreviousAndNext"
					Background="{DynamicResource SystemBaseMediumLowColor}"
					IsVisible="{Binding QueueOpen}"
					DragCompleted="QueueSplitter_DragCompleted" />

				<!-- Process Queue. MinWidth 345 is what the queue tab's two-row bottom bar
				     needs; below that the spinners start clipping. -->
				<Border
					Grid.Column="2"
					Name="queuePane"
					MinWidth="345"
					IsVisible="{Binding QueueOpen}"
					BorderThickness="1,0,0,0"
					BorderBrush="{DynamicResource SystemBaseMediumLowColor}">
					<views:ProcessQueueControl DataContext="{Binding ProcessQueue, Mode=OneTime}"/>
				</Border>
			</Grid>
		</Border>
			
		<!-- Bottom Status Strip -->
		<Grid Grid.Row="3" Margin="8" VerticalAlignment="Bottom" ColumnDefinitions="Auto,Auto,*,Auto">
			<Grid.Styles>
				<Style Selector="ProgressBar:horizontal">
					<Setter Property="MinWidth" Value="100" />
				</Style>
			</Grid.Styles>
			<TextBlock FontSize="14" Grid.Column="0" Text="Upgrading:" VerticalAlignment="Center" IsVisible="{Binding DownloadProgress, Converter={x:Static ObjectConverters.IsNotNull}}" />
			<ProgressBar Grid.Column="1" Margin="5,0,10,0" VerticalAlignment="Stretch" Width="100" Value="{Binding DownloadProgress, TargetNullValue=0}" IsVisible="{Binding DownloadProgress, Converter={x:Static ObjectConverters.IsNotNull}}"/>
			<TextBlock FontSize="14" Grid.Column="2" Text="{Binding VisibleCountText}" VerticalAlignment="Center" />
			<TextBlock FontSize="14" Grid.Column="3" Text="{Binding LibraryStats?.StatusString}" VerticalAlignment="Center" />
		</Grid>
	</Grid>
	</Border>
</Window>
