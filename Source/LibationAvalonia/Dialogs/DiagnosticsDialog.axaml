<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="620"
		MinWidth="620" MinHeight="400"
		Width="760" Height="620"
        x:Class="LibationAvalonia.Dialogs.DiagnosticsDialog"
		xmlns:dialogs="clr-namespace:LibationAvalonia.Dialogs"
		x:DataType="dialogs:DiagnosticsVM"
        Title="Diagnostics">

	<!-- Severity brushes come from the view models (DiagnosticBrushes) rather than resources,
	     so the same mapping serves the accent bar, the value text and the summary banner.
	     Colour is never the only signal: the copied plain text carries [!] / [?] markers. -->
	<Grid Margin="10" RowDefinitions="Auto,*,Auto">

		<!-- Summary banner. Only appears when something is actually wrong, so a healthy
		     install shows a plain list and a problem install shouts. -->
		<Border
			Grid.Row="0"
			IsVisible="{Binding HasProblems}"
			Background="{DynamicResource SystemRegionColor}"
			BorderBrush="{Binding SummaryBrush}"
			BorderThickness="4,0,0,0"
			Padding="12,8"
			Margin="0,0,0,10">
			<TextBlock
				Text="{Binding SummaryText}"
				TextWrapping="Wrap"
				FontWeight="Bold"
				Foreground="{Binding SummaryBrush}" />
		</Border>

		<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
			<ItemsControl ItemsSource="{Binding Sections}">
				<ItemsControl.ItemTemplate>
					<DataTemplate DataType="dialogs:DiagnosticSectionVM">
						<StackPanel Margin="0,0,0,16">

							<TextBlock
								Text="{Binding Name}"
								FontSize="15"
								FontWeight="Bold"
								Margin="0,0,0,4" />
							<Border
								Height="1"
								Background="{DynamicResource SystemBaseMediumLowColor}"
								Margin="0,0,0,6" />

							<ItemsControl ItemsSource="{Binding Items}">
								<ItemsControl.ItemTemplate>
									<DataTemplate DataType="dialogs:DiagnosticItemVM">
										<Border
											BorderBrush="{Binding AccentBrush}"
											BorderThickness="3,0,0,0"
											Padding="8,2,0,2"
											Margin="0,0,0,3">
											<!-- Fixed-width label column keeps values aligned down the
											     whole dialog; values wrap because paths get long. -->
											<Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto">
												<TextBlock
													Grid.Column="0" Grid.Row="0"
													Text="{Binding Label}"
													FontWeight="SemiBold"
													VerticalAlignment="Top"
													Margin="0,0,10,0"
													TextWrapping="Wrap" />
												<!-- Value keeps the theme foreground. Severity is carried by the accent
												     bar and the detail line, so a clean install is not a wall of colour
												     and we never bind a null brush over the theme's own. -->
												<SelectableTextBlock
													Grid.Column="1" Grid.Row="0"
													Text="{Binding Value}"
													TextWrapping="Wrap" />
												<TextBlock
													Grid.Column="1" Grid.Row="1"
													Text="{Binding Detail}"
													IsVisible="{Binding HasDetail}"
													TextWrapping="Wrap"
													FontSize="11"
													Opacity="0.85"
													Margin="0,2,0,4"
													Foreground="{Binding AccentBrush}" />
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<!-- WrapPanel rather than a fixed column grid: the dialog is resizable and these
		     five buttons overflow a narrow window otherwise. -->
		<WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
			<Button Margin="0,2,8,2" Content="Copy to Clipboard" Click="Copy_Click" ToolTip.Tip="Copy everything above as plain text, ready to paste into a bug report." />
			<Button Margin="0,2,8,2" Content="Open Log File" Click="OpenLog_Click" ToolTip.Tip="Open the active log file, or the Libation files folder if there isn't one." />
			<Button Margin="0,2,8,2" Content="Open Libation Files" Click="OpenLibationFiles_Click" />
			<Button Margin="0,2,8,2" Content="Refresh" Click="Refresh_Click" />
			<Button Margin="0,2,0,2" Content="Close" Click="Close_Click" />
		</WrapPanel>
	</Grid>
</Window>
